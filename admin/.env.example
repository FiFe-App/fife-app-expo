# Supabase — service role kulcs, csak a Netlify function-ök oldalán használva.
SUPABASE_URL=https://pdzuvfkkrhtrrrcckwzj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Az admin belépéshez használt jelszó.
ADMIN_PASSWORD=

# Véletlenszerű, hosszú string a bejelentkezési süti aláírásához.
# pl.: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Vesszővel elválasztott IP címek, amelyeket a login SOHA nem tilt ki
# (pl. az otthoni / irodai fix IP-d), hogy ne zárhasd ki magad.
ADMIN_IP_ALLOWLIST=
