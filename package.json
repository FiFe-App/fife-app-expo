  "main": "expo-router/entry",
  "version": "1.4.1",
  "scripts": {
    "dev": "node -e \"require('fs').copyFileSync('.env.dev','.env')\" && expo start",
    "prod": "node -e \"require('fs').copyFileSync('.env.prod','.env')\" && expo start",
    "android": "expo run:android",
    "build": "node -e \"require('fs').copyFileSync('.env.prod','.env')\" && npx expo export --platform web",
    "ios": "expo run:ios",
    "deploy": "node -e \"require('fs').copyFileSync('.env.prod','.env')\" && npx expo export -p web && npx --yes netlify-cli deploy",
    "deploy-prod": "node -e \"require('fs').copyFileSync('.env.prod','.env')\" && npx expo export -p web && npx --yes netlify-cli deploy --prod",
    "update": "node -e \"require('fs').copyFileSync('.env.prod','.env')\" && eas update --channel production --environment production",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "test:ci": "jest --ci --watchAll=false",
    "test:edge": "jest --config jest.edge.config.js --ci --watchAll=false",
    "lint": "npx expo lint",
    "lint:eslint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "eslint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "postinstall": "patch-package",
    "updateTypes": "npx supabase gen types --lang=typescript --project-id pdzuvfkkrhtrrrcckwzj --schema public > database.types.ts",
    "updateTypesLocal": "npx supabase gen types typescript --local > database.types.ts",
    "db:push": "npx supabase db push",
    "db:reset": "npx supabase db reset",
    "db:status": "npx supabase migration list",
    "functions:deploy": "npx supabase functions deploy --project-ref pdzuvfkkrhtrrrcckwzj"
  },
  "release": {
    "branches": [
      "master"
    ]
  },
